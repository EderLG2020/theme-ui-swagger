{
  "openapi": "3.0.1",
  "info": {
    "title": "PetVerse API",
    "version": "3.1.0",
    "description": "API pública de **PetVerse** para gestionar mascotas, dueños, pedidos y autenticación.\n\n### Autenticación\nLa mayoría de los endpoints requieren un token `Bearer` obtenido en `POST /auth/login`. Los endpoints administrativos además requieren el rol `admin`.\n\n### Rate limiting\nTodas las respuestas incluyen las cabeceras `X-RateLimit-Limit` y `X-RateLimit-Remaining`. Al superar el límite se responde `429 Too Many Requests`.",
    "termsOfService": "https://petverse.example.com/terms",
    "contact": {
      "name": "Equipo de Plataforma",
      "email": "api-support@petverse.example.com",
      "url": "https://petverse.example.com/support"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    { "url": "https://api.petverse.example.com/v3", "description": "Producción" },
    { "url": "https://staging-api.petverse.example.com/v3", "description": "Staging" },
    { "url": "http://localhost:3000/v3", "description": "Desarrollo local" }
  ],
  "tags": [
    { "name": "Pets", "description": "Alta, consulta y ciclo de vida de mascotas" },
    { "name": "Owners", "description": "Dueños registrados y sus mascotas" },
    { "name": "Orders", "description": "Pedidos de adopción y compra" },
    { "name": "Auth", "description": "Registro, login y sesión" },
    { "name": "Users", "description": "Administración de usuarios internos" },
    { "name": "Webhooks", "description": "Notificaciones push hacia sistemas externos" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/pets": {
      "get": {
        "tags": ["Pets"],
        "summary": "Listar mascotas",
        "description": "Devuelve una lista **paginada** de mascotas. Soporta filtros por `status`, `species` y texto libre en `search`.",
        "parameters": [
          { "name": "page", "in": "query", "description": "Número de página (base 1)", "required": false, "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "pageSize", "in": "query", "description": "Resultados por página (máx. 100)", "required": false, "schema": { "type": "integer", "default": 20 }, "example": 20 },
          { "name": "status", "in": "query", "description": "Filtrar por estado", "required": false, "schema": { "type": "string", "enum": ["available", "pending", "sold"] }, "example": "available" },
          { "name": "species", "in": "query", "description": "Filtrar por especie", "required": false, "schema": { "type": "string" }, "example": "dog" },
          { "name": "search", "in": "query", "description": "Búsqueda de texto libre por nombre o raza", "required": false, "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "description": "Campo y dirección de orden, ej. `-createdAt`", "required": false, "schema": { "type": "string" }, "example": "-createdAt" },
          { "name": "X-Request-Id", "in": "header", "description": "Id de trazabilidad de la petición, se refleja en los logs", "required": false }
        ],
        "responses": {
          "200": {
            "description": "Listado obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "description": "Mascotas encontradas" },
                    "meta": { "type": "object", "description": "Metadatos de paginación" }
                  }
                },
                "example": {
                  "data": [
                    { "id": "pet_01H9Z", "name": "Firulais", "species": "dog", "breed": "Labrador", "status": "available", "ownerId": null, "createdAt": "2026-06-12T14:30:00Z" },
                    { "id": "pet_01H9X", "name": "Michi", "species": "cat", "breed": "Siamés", "status": "pending", "ownerId": "own_04A1", "createdAt": "2026-07-01T09:15:00Z" }
                  ],
                  "meta": { "page": 1, "pageSize": 20, "total": 128, "totalPages": 7 }
                }
              }
            }
          },
          "400": { "description": "Parámetros de consulta inválidos", "content": { "application/json": { "example": { "code": "invalid_query", "message": "pageSize debe ser menor o igual a 100" } } } },
          "401": { "description": "Token ausente o inválido", "content": { "application/json": { "example": { "code": "unauthorized", "message": "Missing bearer token" } } } },
          "500": { "description": "Error interno del servidor", "content": { "application/json": { "example": { "code": "internal_error", "message": "Something went wrong" } } } }
        }
      },
      "post": {
        "tags": ["Pets"],
        "summary": "Registrar mascota",
        "description": "Crea una nueva mascota. Requiere rol `staff` o `admin`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "species"],
                "properties": {
                  "name": { "type": "string", "description": "Nombre de la mascota", "example": "Rocky" },
                  "species": { "type": "string", "description": "Especie", "example": "dog" },
                  "breed": { "type": "string", "description": "Raza", "example": "Bulldog Francés" },
                  "status": { "type": "string", "description": "Estado inicial", "example": "available" }
                }
              },
              "example": { "name": "Rocky", "species": "dog", "breed": "Bulldog Francés", "status": "available" }
            }
          }
        },
        "responses": {
          "201": { "description": "Mascota creada", "content": { "application/json": { "example": { "id": "pet_01H9Y", "name": "Rocky", "species": "dog", "breed": "Bulldog Francés", "status": "available", "createdAt": "2026-08-31T10:00:00Z" } } } },
          "400": { "description": "Datos inválidos", "content": { "application/json": { "example": { "code": "validation_error", "message": "species is required" } } } },
          "401": { "description": "No autenticado" },
          "422": { "description": "Entidad no procesable", "content": { "application/json": { "example": { "code": "unprocessable_entity", "message": "species 'dragon' no está soportada" } } } }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "tags": ["Pets"],
        "summary": "Obtener mascota por id",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "description": "Identificador único de la mascota", "schema": { "type": "string" }, "example": "pet_01H9Z" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "id": "pet_01H9Z", "name": "Firulais", "species": "dog", "breed": "Labrador", "status": "available", "createdAt": "2026-06-12T14:30:00Z" } } } },
          "401": { "description": "No autenticado" },
          "404": { "description": "Mascota no encontrada", "content": { "application/json": { "example": { "code": "not_found", "message": "Pet pet_01H9Z not found" } } } }
        }
      },
      "put": {
        "tags": ["Pets"],
        "summary": "Reemplazar mascota",
        "description": "Actualiza **todos** los campos de la mascota. Para actualizaciones parciales usa `PATCH`.",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Firulais II" },
                  "species": { "type": "string", "example": "dog" },
                  "breed": { "type": "string", "example": "Labrador" },
                  "status": { "type": "string", "example": "sold" }
                }
              },
              "example": { "name": "Firulais II", "species": "dog", "breed": "Labrador", "status": "sold" }
            }
          }
        },
        "responses": {
          "200": { "description": "Mascota actualizada", "content": { "application/json": { "example": { "id": "pet_01H9Z", "name": "Firulais II", "status": "sold" } } } },
          "400": { "description": "Datos inválidos" },
          "401": { "description": "No autenticado" },
          "404": { "description": "Mascota no encontrada" }
        }
      },
      "patch": {
        "tags": ["Pets"],
        "summary": "Actualizar mascota parcialmente",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "breed": { "type": "string", "example": "Golden Retriever" } } },
              "example": { "breed": "Golden Retriever" }
            }
          }
        },
        "responses": {
          "200": { "description": "Mascota actualizada", "content": { "application/json": { "example": { "id": "pet_01H9Z", "breed": "Golden Retriever" } } } },
          "400": { "description": "Datos inválidos" },
          "404": { "description": "Mascota no encontrada" },
          "409": { "description": "Conflicto de versión", "content": { "application/json": { "example": { "code": "conflict", "message": "El recurso fue modificado por otro usuario" } } } }
        }
      },
      "delete": {
        "tags": ["Pets"],
        "summary": "Eliminar mascota",
        "description": "**Deprecado**: usa `PATCH /pets/{petId}/status` con `status: archived` en su lugar. Este endpoint se eliminará en `v4`.",
        "deprecated": true,
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Eliminada sin contenido" },
          "401": { "description": "No autenticado" },
          "404": { "description": "Mascota no encontrada" }
        }
      }
    },
    "/pets/{petId}/status": {
      "patch": {
        "tags": ["Pets"],
        "summary": "Cambiar estado de una mascota",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "session", "in": "cookie", "required": false, "description": "Cookie de sesión del usuario autenticado en el panel web" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "description": "Nuevo estado", "example": "sold" } } },
              "example": { "status": "sold" }
            }
          }
        },
        "responses": {
          "200": { "description": "Estado actualizado", "content": { "application/json": { "example": { "id": "pet_01H9Z", "status": "sold" } } } },
          "400": { "description": "Estado inválido", "content": { "application/json": { "example": { "code": "invalid_status", "message": "'flying' no es un estado válido" } } } },
          "404": { "description": "Mascota no encontrada" }
        }
      }
    },
    "/pets/{petId}/photos": {
      "get": {
        "tags": ["Pets"],
        "summary": "Listar fotos de una mascota",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": [{ "id": "photo_001", "url": "https://cdn.petverse.example.com/pets/pet_01H9Z/1.jpg", "primary": true }] } } },
          "404": { "description": "Mascota no encontrada" }
        }
      },
      "post": {
        "tags": ["Pets"],
        "summary": "Subir foto de mascota",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "Archivo de imagen (jpg/png, máx. 5MB)" },
                  "primary": { "type": "boolean", "description": "Marcar como foto principal", "example": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Foto subida", "content": { "application/json": { "example": { "id": "photo_002", "url": "https://cdn.petverse.example.com/pets/pet_01H9Z/2.jpg" } } } },
          "400": { "description": "Archivo inválido o demasiado grande" },
          "404": { "description": "Mascota no encontrada" }
        }
      }
    },
    "/owners": {
      "get": {
        "tags": ["Owners"],
        "summary": "Listar dueños",
        "description": "Devuelve todos los dueños registrados, paginado.",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "data": [{ "id": "own_04A1", "name": "Ana Torres", "email": "ana@example.com", "petsCount": 2 }], "meta": { "page": 1, "pageSize": 20, "total": 54, "totalPages": 3 } } } } },
          "401": { "description": "No autenticado" }
        }
      },
      "post": {
        "tags": ["Owners"],
        "summary": "Registrar dueño",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email"],
                "properties": {
                  "name": { "type": "string", "example": "Ana Torres" },
                  "email": { "type": "string", "format": "email", "example": "ana@example.com" },
                  "phone": { "type": "string", "example": "+52 55 1234 5678" }
                }
              },
              "example": { "name": "Ana Torres", "email": "ana@example.com", "phone": "+52 55 1234 5678" }
            }
          }
        },
        "responses": {
          "201": { "description": "Dueño creado", "content": { "application/json": { "example": { "id": "own_04A1", "name": "Ana Torres", "email": "ana@example.com" } } } },
          "400": { "description": "Datos inválidos" },
          "409": { "description": "El email ya está registrado", "content": { "application/json": { "example": { "code": "email_taken", "message": "ana@example.com ya está registrado" } } } }
        }
      }
    },
    "/owners/{ownerId}": {
      "get": {
        "tags": ["Owners"],
        "summary": "Obtener dueño por id",
        "parameters": [{ "name": "ownerId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "id": "own_04A1", "name": "Ana Torres", "email": "ana@example.com" } } } },
          "404": { "description": "Dueño no encontrado" }
        }
      },
      "patch": {
        "tags": ["Owners"],
        "summary": "Actualizar dueño",
        "parameters": [{ "name": "ownerId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "example": { "phone": "+52 55 9876 5432" } } } },
        "responses": {
          "200": { "description": "Dueño actualizado", "content": { "application/json": { "example": { "id": "own_04A1", "phone": "+52 55 9876 5432" } } } },
          "404": { "description": "Dueño no encontrado" }
        }
      },
      "delete": {
        "tags": ["Owners"],
        "summary": "Eliminar dueño",
        "description": "Solo disponible para usuarios con rol `admin`.",
        "parameters": [{ "name": "ownerId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Eliminado sin contenido" },
          "403": { "description": "No tienes permisos suficientes", "content": { "application/json": { "example": { "code": "forbidden", "message": "Se requiere rol admin" } } } },
          "404": { "description": "Dueño no encontrado" }
        }
      }
    },
    "/owners/{ownerId}/pets": {
      "get": {
        "tags": ["Owners"],
        "summary": "Listar mascotas de un dueño",
        "parameters": [{ "name": "ownerId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": [{ "id": "pet_01H9X", "name": "Michi", "status": "pending" }] } } },
          "404": { "description": "Dueño no encontrado" }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Listar pedidos",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] } },
          { "name": "from", "in": "query", "description": "Fecha inicial (ISO 8601)", "required": false, "schema": { "type": "string", "format": "date" }, "example": "2026-01-01" },
          { "name": "to", "in": "query", "description": "Fecha final (ISO 8601)", "required": false, "schema": { "type": "string", "format": "date" }, "example": "2026-08-31" }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "data": [{ "id": "ord_9F21", "petId": "pet_01H9Z", "ownerId": "own_04A1", "status": "paid", "amount": 2500, "currency": "MXN" }], "meta": { "page": 1, "pageSize": 20, "total": 12, "totalPages": 1 } } } } },
          "401": { "description": "No autenticado" }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Crear pedido",
        "description": "Crea un pedido de adopción o compra para una mascota disponible.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["petId", "ownerId"],
                "properties": {
                  "petId": { "type": "string", "example": "pet_01H9Z" },
                  "ownerId": { "type": "string", "example": "own_04A1" },
                  "amount": { "type": "number", "description": "Monto en centavos", "example": 2500 },
                  "currency": { "type": "string", "example": "MXN" }
                }
              },
              "example": { "petId": "pet_01H9Z", "ownerId": "own_04A1", "amount": 2500, "currency": "MXN" }
            }
          }
        },
        "responses": {
          "201": { "description": "Pedido creado", "content": { "application/json": { "example": { "id": "ord_9F21", "status": "pending" } } } },
          "400": { "description": "Datos inválidos" },
          "422": { "description": "La mascota ya no está disponible", "content": { "application/json": { "example": { "code": "pet_unavailable", "message": "pet_01H9Z ya fue vendida" } } } }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Obtener pedido por id",
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "id": "ord_9F21", "status": "paid", "amount": 2500, "currency": "MXN" } } } },
          "404": { "description": "Pedido no encontrado" }
        }
      }
    },
    "/orders/{orderId}/status": {
      "patch": {
        "tags": ["Orders"],
        "summary": "Actualizar estado de un pedido",
        "description": "Solo disponible para usuarios con rol `admin` o `staff`.",
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "example": { "status": "shipped" } } } },
        "responses": {
          "200": { "description": "Estado actualizado", "content": { "application/json": { "example": { "id": "ord_9F21", "status": "shipped" } } } },
          "400": { "description": "Transición de estado inválida" },
          "403": { "description": "No tienes permisos suficientes" },
          "404": { "description": "Pedido no encontrado" }
        }
      }
    },
    "/orders/{orderId}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Cancelar pedido",
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Pedido cancelado", "content": { "application/json": { "example": { "id": "ord_9F21", "status": "cancelled" } } } },
          "404": { "description": "Pedido no encontrado" },
          "409": { "description": "El pedido ya fue enviado y no se puede cancelar", "content": { "application/json": { "example": { "code": "conflict", "message": "No se puede cancelar un pedido enviado" } } } }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar usuario",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "ana@example.com" },
                  "password": { "type": "string", "format": "password", "example": "S3guro!123" }
                }
              },
              "example": { "email": "ana@example.com", "password": "S3guro!123" }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario creado", "content": { "application/json": { "example": { "id": "usr_01A", "email": "ana@example.com" } } } },
          "400": { "description": "Contraseña débil o email inválido" },
          "409": { "description": "El email ya está registrado" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Iniciar sesión",
        "description": "Autentica un usuario y devuelve un access token de corta duración y una cookie `refreshToken` httpOnly.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "example": { "email": "ana@example.com", "password": "S3guro!123" } } }
        },
        "responses": {
          "200": { "description": "Login exitoso", "content": { "application/json": { "example": { "accessToken": "eyJhbGciOiJIUzI1NiIs...", "expiresIn": 3600 } } } },
          "401": { "description": "Credenciales inválidas", "content": { "application/json": { "example": { "code": "invalid_credentials", "message": "Email o contraseña incorrectos" } } } },
          "429": { "description": "Demasiados intentos, intenta más tarde", "content": { "application/json": { "example": { "code": "rate_limited", "message": "Intenta de nuevo en 60 segundos" } } } }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refrescar token de sesión",
        "parameters": [{ "name": "refreshToken", "in": "cookie", "required": true, "description": "Cookie httpOnly emitida en el login" }],
        "responses": {
          "200": { "description": "Token refrescado", "content": { "application/json": { "example": { "accessToken": "eyJhbGciOiJIUzI1NiIs...", "expiresIn": 3600 } } } },
          "401": { "description": "Refresh token inválido o expirado" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión",
        "description": "Invalida el refresh token actual.",
        "responses": {
          "204": { "description": "Sesión cerrada" },
          "401": { "description": "No autenticado" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Obtener usuario actual",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": true, "description": "Token en formato `Bearer <token>`" }
        ],
        "responses": {
          "200": { "description": "Usuario autenticado", "content": { "application/json": { "example": { "id": "usr_01A", "email": "ana@example.com", "role": "customer" } } } },
          "401": { "description": "No autenticado" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Listar usuarios internos",
        "description": "Requiere rol `admin`.",
        "parameters": [
          { "name": "role", "in": "query", "required": false, "schema": { "type": "string", "enum": ["admin", "staff", "customer"] } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": [{ "id": "usr_01A", "email": "ana@example.com", "role": "customer" }, { "id": "usr_02B", "email": "staff@petverse.example.com", "role": "staff" }] } } },
          "401": { "description": "No autenticado" },
          "403": { "description": "Se requiere rol admin" }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": ["Users"],
        "summary": "Obtener usuario por id",
        "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": { "id": "usr_01A", "email": "ana@example.com", "role": "customer" } } } },
          "401": { "description": "No autenticado" },
          "403": { "description": "Solo puedes consultar tu propio usuario" },
          "404": { "description": "Usuario no encontrado" }
        }
      }
    },
    "/users/{userId}/role": {
      "patch": {
        "tags": ["Users"],
        "summary": "Cambiar rol de un usuario",
        "description": "Requiere rol `admin`.",
        "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "example": { "role": "staff" } } } },
        "responses": {
          "200": { "description": "Rol actualizado", "content": { "application/json": { "example": { "id": "usr_02B", "role": "staff" } } } },
          "400": { "description": "Rol inválido" },
          "403": { "description": "Se requiere rol admin" },
          "404": { "description": "Usuario no encontrado" }
        }
      }
    },
    "/webhooks": {
      "get": {
        "tags": ["Webhooks"],
        "summary": "Listar webhooks registrados",
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "example": [{ "id": "wh_001", "url": "https://crm.example.com/hooks/petverse", "event": "order.paid" }] } } },
          "401": { "description": "No autenticado" }
        }
      },
      "post": {
        "tags": ["Webhooks"],
        "summary": "Registrar webhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url", "event"],
                "properties": {
                  "url": { "type": "string", "format": "uri", "example": "https://crm.example.com/hooks/petverse" },
                  "event": { "type": "string", "description": "Evento a escuchar", "example": "order.paid" }
                }
              },
              "example": { "url": "https://crm.example.com/hooks/petverse", "event": "order.paid" }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook creado", "content": { "application/json": { "example": { "id": "wh_002", "url": "https://crm.example.com/hooks/petverse", "event": "order.paid" } } } },
          "400": { "description": "URL o evento inválido" },
          "401": { "description": "No autenticado" }
        }
      }
    },
    "/webhooks/{webhookId}": {
      "delete": {
        "tags": ["Webhooks"],
        "summary": "Eliminar webhook",
        "parameters": [{ "name": "webhookId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Eliminado sin contenido" },
          "401": { "description": "No autenticado" },
          "404": { "description": "Webhook no encontrado" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
    },
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "pet_01H9Z" },
          "name": { "type": "string", "example": "Firulais" },
          "species": { "type": "string", "example": "dog" },
          "breed": { "type": "string", "example": "Labrador" },
          "status": { "type": "string", "enum": ["available", "pending", "sold"] },
          "ownerId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Owner": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "own_04A1" },
          "name": { "type": "string", "example": "Ana Torres" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ord_9F21" },
          "petId": { "type": "string" },
          "ownerId": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "paid", "shipped", "delivered", "cancelled"] },
          "amount": { "type": "number" },
          "currency": { "type": "string", "example": "MXN" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "usr_01A" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "staff", "customer"] }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "not_found" },
          "message": { "type": "string", "example": "Recurso no encontrado" }
        }
      }
    }
  }
}
